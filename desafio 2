import xmlrpc.client

# Cliente conectando ao servidor
servidor = xmlrpc.client.ServerProxy("http://localhost:8000")

while True:
    print("\n=== Calculadora Distribuída ===")
    
    a = float(input("Digite o primeiro valor: "))
    b = float(input("Digite o segundo valor: "))
    
    print("\n1 - Soma")
    print("2 - Subtração")
    print("3 - Multiplicar")
    print("4 - Dividir")
    
    opcao = input("\nEscolha uma operação (1-4): ")
    
    if opcao == "1":
        resultado = servidor.soma(a, b)
        print(f"Resultado: {a} + {b} = {resultado}")
    elif opcao == "2":
        resultado = servidor.subtracao(a, b)
        print(f"Resultado: {a} - {b} = {resultado}")
    elif opcao == "3":
        resultado = servidor.multiplicacao(a, b)
        print(f"Resultado: {a} * {b} = {resultado}")
    elif opcao == "4":
        resultado = servidor.divisao(a, b)
        print(f"Resultado: {a} / {b} = {resultado}")
    else:
        print("Opção inválida!")
    
    continuar = input("\nDeseja fazer outra operação? (s/n): ")
    if continuar.lower() != "s":
        print("Até logo!")
        break
